SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=product-images
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_SESSION_SECRET=generate-a-random-secret-with-at-least-32-bytes
# Set this to the public site origin when deployed behind a proxy.
# ADMIN_ALLOWED_ORIGIN=https://your-public-site.example
SECRETS_SCAN_OMIT_KEYS=NEXT_PUBLIC_SUPABASE_URL,SUPABASE_STORAGE_BUCKET
