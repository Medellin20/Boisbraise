NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
# Server only: required for admin reads and writes. Never expose this as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_SESSION_SECRET=generate-a-random-secret-with-at-least-32-bytes
